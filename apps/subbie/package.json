{
  "name": "subbie",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run subbie-core#build && vp dev --port 4230 --open",
    "build": "vp run subbie-core#build && tsc && vp build",
    "preview": "vp preview",
    "deploy": "vp run subbie-core#build && tsc && vp build && wrangler deploy",
    "deploy:preview": "vp run subbie-core#build && tsc && APP_CHANNEL=preview vp build && wrangler preview --name preview"
  },
  "dependencies": {
    "@ionic/react": "^9.0.9",
    "@ionic/react-router": "^9.0.9",
    "@rdlabo/ionic-theme-ios27": "catalog:",
    "ionicons": "^8.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0",
    "subbie-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vite-plus": "catalog:",
    "workbox-window": "catalog:",
    "wrangler": "catalog:"
  }
}
